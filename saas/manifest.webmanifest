{
  "id": "/saas/",
  "name": "Oprun — AI Office Manager",
  "short_name": "Oprun",
  "start_url": "/saas/workspace.html",
  "scope": "/saas/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#080b10",
  "theme_color": "#080b10",
  "description": "Run your world. The AI office manager for service businesses: your office runs, you approve.",
  "icons": [
    {
      "src": "/saas/oprun-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/saas/oprun-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/saas/oprun-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
